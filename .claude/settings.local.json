            "timeout": 30,
            "statusMessage": ""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "knowl agent-reminder claude --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      }
    ]
  }
}
