{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl agent-hook claude SessionStart --json",
            "timeout": 30,
            "statusMessage": "Loading Knowl memory"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl agent-hook claude SubagentStart --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      }
    ],
    "PreToolUse": [
